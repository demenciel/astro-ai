{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/status.mjs --hook 2>/dev/null || true" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run status*)",
      "Bash(npm run check*)",
      "Bash(npm run build*)",
      "Bash(npm run new*)",
      "Bash(npm run dev*)",
      "Bash(npm run db:migrate)",
      "Bash(npm run types)",
      "Bash(npm run fix*)"
    ],
    "deny": ["Read(./.env.setup)", "Read(./.dev.vars)"]
  }
}
