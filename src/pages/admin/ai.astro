---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { enabledProviders } from '~/lib/ai';

export const prerender = false;

const providers = enabledProviders();
---

<AdminLayout title="AI Playground">
  {
    providers.length === 0 ? (
      <p class="text-sm text-muted">
        No AI provider configured. Add any of OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, XAI_API_KEY,
        DEEPSEEK_API_KEY.
      </p>
    ) : (
      <form id="ai-form" class="space-y-3 max-w-2xl">
        <div class="flex gap-3">
          <select
            name="provider"
            class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 px-3 py-2"
          >
            {providers.map((p) => (
              <option value={p.id}>{p.label}</option>
            ))}
          </select>
          <input
            name="model"
            placeholder="Model (optional)"
            class="flex-1 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 px-3 py-2"
          />
        </div>
        <textarea
          name="prompt"
          rows="5"
          required
          placeholder="Ask something…"
          class="w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 px-3 py-2"
        />
        <button class="btn-primary" type="submit">
          Send
        </button>
        <pre id="ai-output" class="whitespace-pre-wrap text-sm rounded-lg bg-gray-50 dark:bg-slate-900 p-4 min-h-16" />
      </form>
    )
  }
</AdminLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('ai-form') as HTMLFormElement | null;
    const out = document.getElementById('ai-output');
    if (!form || !out) return;
    form.onsubmit = async (e) => {
      e.preventDefault();
      out.textContent = 'Thinking…';
      const res = await fetch('/api/admin/ai', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = (await res.json()) as {
        ok: boolean;
        provider?: string;
        model?: string;
        text?: string;
        error?: string;
      };
      out.textContent = data.ok ? `[${data.provider} · ${data.model}]\n\n${data.text}` : `Error: ${data.error}`;
    };
  });
</script>
