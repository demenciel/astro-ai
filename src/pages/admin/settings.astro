---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { env, features } from '~/lib/env';
import { PROVIDERS } from '~/lib/ai';

export const prerender = false;

const f = features();
const rows: [string, boolean, string][] = [
  ['D1 database (DB)', f.db, 'wrangler.jsonc → d1_databases'],
  ['Queue (JOBS)', f.queue, 'wrangler.jsonc → queues (jobs run inline without it)'],
  ['Admin password', f.admin, 'ADMIN_PASSWORD secret'],
  ['Stripe', f.stripe, 'STRIPE_SECRET_KEY secret'],
  ['Stripe webhook', f.stripeWebhook, 'STRIPE_WEBHOOK_SECRET (created by npm run setup)'],
  ...Object.values(PROVIDERS).map((p): [string, boolean, string] => [p.label, Boolean(env[p.keyName]), p.keyName]),
];
---

<AdminLayout title="Settings">
  <p class="text-sm text-muted mb-4">
    Integrations are enabled by secrets. Set them with <code>npm run setup</code> (production) or in
    <code>.dev.vars</code> (local). Values are never shown here.
  </p>
  <ul class="divide-y divide-gray-200 dark:divide-slate-800 rounded-lg border border-gray-200 dark:border-slate-800">
    {
      rows.map(([name, ok, hint]) => (
        <li class="flex items-center justify-between gap-4 px-4 py-3 text-sm">
          <div>
            <div class="font-medium">{name}</div>
            <div class="text-muted">{hint}</div>
          </div>
          <span class:list={['font-semibold', ok ? 'text-green-600' : 'text-gray-400']}>{ok ? 'On' : 'Off'}</span>
        </li>
      ))
    }
  </ul>
  <p class="text-sm text-muted mt-4">Site URL: <code>{env.SITE_URL}</code></p>
</AdminLayout>
