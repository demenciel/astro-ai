---
/**
 * Generic table: <DataTable columns={[{ key: 'email', label: 'Email' }]} rows={rows} />
 * `format` lets a column render a custom string.
 */
export interface Column {
  key: string;
  label: string;
  format?: (value: unknown, row: Record<string, unknown>) => string;
}
export interface Props {
  columns: Column[];
  rows: object[];
  empty?: string;
}
const { columns, rows, empty = 'Nothing here yet.' } = Astro.props;
const data = rows as Record<string, unknown>[];
---

<div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-800">
  <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 dark:bg-slate-900">
      <tr>{columns.map((c: Column) => <th class="px-3 py-2 font-semibold whitespace-nowrap">{c.label}</th>)}</tr>
    </thead>
    <tbody>
      {
        data.length === 0 ? (
          <tr>
            <td class="px-3 py-6 text-center text-muted" colspan={columns.length}>
              {empty}
            </td>
          </tr>
        ) : (
          data.map((row) => (
            <tr class="border-t border-gray-200 dark:border-slate-800 align-top">
              {columns.map((c: Column) => (
                <td class="px-3 py-2 max-w-md break-words">
                  {c.format ? c.format(row[c.key], row) : String(row[c.key] ?? '—')}
                </td>
              ))}
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</div>
