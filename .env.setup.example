# Setup inputs for `npm run setup`. Copy to .env.setup (gitignored) and fill in.
# Paste keys here yourself rather than into an AI chat: the agent only needs to
# know which ones are set (`npm run status` shows names, never values).
# Everything except the Cloudflare token is optional. Re-run setup any time.

# --- Project ---------------------------------------------------------------
PROJECT_NAME=
# Custom domain (optional). Default: https://<name>.<subdomain>.workers.dev
SITE_URL=

# --- Cloudflare (required for deploy) -------------------------------------
# https://dash.cloudflare.com/profile/api-tokens -> Create Token -> "Edit Cloudflare Workers"
# template, then add: Account / D1 / Edit, Account / Queues / Edit.
CLOUDFLARE_API_TOKEN=
# Optional: auto-detected when the token sees a single account.
CLOUDFLARE_ACCOUNT_ID=

# --- GitHub (optional: enables deploy on push) -----------------------------
# Fine-grained token, this repo only, permission "Secrets: Read and write".
# Not needed if the `gh` CLI is installed and logged in.
GITHUB_TOKEN=
# owner/name. Auto-detected from `git remote get-url origin`.
GITHUB_REPO=

# --- Admin panel (generated if empty) --------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Stripe (optional) -----------------------------------------------------
# https://dashboard.stripe.com/test/apikeys (start with test keys: sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Created automatically by setup (webhook endpoint). Leave empty.
STRIPE_WEBHOOK_SECRET=

# --- AI providers (all optional, any subset) -------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
